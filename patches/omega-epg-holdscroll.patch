+      // Announce the changed viewport - but not for every step of a key-driven
+      // scroll: the announce makes the guide window copy the whole timeline list
+      // on the gui thread (CGUIWindowPVRGuideBase: GUI_MSG_REFRESH_LIST ->
+      // Refresh(true) -> GetDirectory), which starves rendering on slow hardware
+      // ("epg-holdscroll"). The grid model refills itself lazily
+      // (GetGridItemPtr), so the copy can wait until navigation settles; the
+      // deferred announce is sent from Process().
+      if (m_lastHoldTime != 0 && CTimeUtils::GetFrameTime() - m_lastHoldTime < 1000)
